# Discord channel webhook URL (preferred; create one in the squeeze alert channel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional fallback for direct bot posting when no webhook is configured
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CHANNEL_ID=1505287069512237177

# Reddit API credentials (free at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=SqueezeScanner/1.0 by YourUsername

# Score threshold to trigger a Discord alert (0-100)
ALERT_THRESHOLD=75

# Secondary gate for potential-squeeze alerts before the 75+ hot tier
ALERT_POTENTIAL_THRESHOLD=50
ALERT_MIN_SETUP_SCORE=20
ALERT_MIN_TRIGGER_SCORE=20
ALERT_MIN_SHORT_INTEREST_PCT=20
ALERT_MIN_RELATIVE_VOLUME=2

# How often to run the scanner during market hours (minutes)
SCAN_INTERVAL_MINUTES=30

# Database location
DATABASE_URL=sqlite:///./scanner.db

# CORS origin for your website
ALLOWED_ORIGIN=https://theinvestingclinic.com
